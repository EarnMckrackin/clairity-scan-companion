{
  "manifest_version": 3,
  "name": "clAIrity Scan Companion",
  "description": "Scan webpages and selected text for AI/media trust clues.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with clAIrity"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["https://*/", "http://*/"]
}
